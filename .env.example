SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./test.db
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional. Leave empty to use the built-in in-memory cache.
# Example for a local Redis: redis://localhost:6379/0
# Example for a hosted Redis with TLS: rediss://default:<password>@<host>:6379
REDIS_URL=

# Optional tuning (these are the defaults)
CACHE_TTL_SECONDS=30
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=5
REGISTER_RATE_LIMIT=10
WRITE_RATE_LIMIT=30

# Background jobs (Celery). Leave empty to use a local folder (.celery/) as the queue.
CELERY_BROKER_URL=

# Optional: a URL that receives a POST when a match finishes, e.g. http://127.0.0.1:9000
WEBHOOK_URL=
